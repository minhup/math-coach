# Local development only. Do not reuse these values outside an isolated workstation.
MATH_COACH_ENVIRONMENT=development
MATH_COACH_DATABASE_URL=postgresql+asyncpg://math_coach:math_coach_dev@localhost:5432/math_coach
MATH_COACH_TEST_DATABASE_URL=postgresql+asyncpg://math_coach:math_coach_dev@localhost:5432/math_coach_test
MATH_COACH_DEVELOPMENT_INVITE_CODE=MATH-COACH-LOCAL
MATH_COACH_SESSION_COOKIE_SECURE=false
MATH_COACH_OBJECT_STORAGE_ENDPOINT=localhost:9000
MATH_COACH_OBJECT_STORAGE_PUBLIC_ENDPOINT=localhost:9000
MATH_COACH_OBJECT_STORAGE_ACCESS_KEY=math_coach_dev
MATH_COACH_OBJECT_STORAGE_SECRET_KEY=local-object-storage-only
MATH_COACH_OBJECT_STORAGE_BUCKET=math-coach-dev
MATH_COACH_OBJECT_STORAGE_SECURE=false
MATH_COACH_OBJECT_STORAGE_PUBLIC_SECURE=false
MATH_COACH_TRANSCRIPTION_PROVIDER=fake
MATH_COACH_TRANSCRIPTION_MODEL_SNAPSHOT=m6-transcription-fixture-v1
MATH_COACH_TRANSCRIPTION_TIMEOUT_SECONDS=60

