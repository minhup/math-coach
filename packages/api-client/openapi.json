{
  "components": {
    "schemas": {
      "ErrorDetail": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "requestId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Requestid"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorEnvelope": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorEnvelope",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "PilotLoginRequest": {
        "properties": {
          "inviteCode": {
            "maxLength": 128,
            "minLength": 4,
            "title": "Invitecode",
            "type": "string"
          }
        },
        "required": [
          "inviteCode"
        ],
        "title": "PilotLoginRequest",
        "type": "object"
      },
      "PresignUploadRequest": {
        "properties": {
          "contentType": {
            "enum": [
              "image/jpeg",
              "image/png",
              "image/webp"
            ],
            "title": "Contenttype",
            "type": "string"
          },
          "fileName": {
            "maxLength": 255,
            "minLength": 1,
            "title": "Filename",
            "type": "string"
          },
          "sizeBytes": {
            "maximum": 10485760.0,
            "minimum": 1.0,
            "title": "Sizebytes",
            "type": "integer"
          }
        },
        "required": [
          "fileName",
          "contentType",
          "sizeBytes"
        ],
        "title": "PresignUploadRequest",
        "type": "object"
      },
      "PresignUploadResponse": {
        "properties": {
          "expiresAt": {
            "format": "date-time",
            "title": "Expiresat",
            "type": "string"
          },
          "uploadId": {
            "format": "uuid",
            "title": "Uploadid",
            "type": "string"
          },
          "uploadUrl": {
            "title": "Uploadurl",
            "type": "string"
          }
        },
        "required": [
          "uploadId",
          "uploadUrl",
          "expiresAt"
        ],
        "title": "PresignUploadResponse",
        "type": "object"
      },
      "SessionResponse": {
        "properties": {
          "expiresAt": {
            "format": "date-time",
            "title": "Expiresat",
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/UserResponse"
          }
        },
        "required": [
          "user",
          "expiresAt"
        ],
        "title": "SessionResponse",
        "type": "object"
      },
      "UploadResponse": {
        "properties": {
          "contentType": {
            "enum": [
              "image/jpeg",
              "image/png",
              "image/webp"
            ],
            "title": "Contenttype",
            "type": "string"
          },
          "createdAt": {
            "format": "date-time",
            "title": "Createdat",
            "type": "string"
          },
          "fileName": {
            "title": "Filename",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "sizeBytes": {
            "title": "Sizebytes",
            "type": "integer"
          },
          "status": {
            "enum": [
              "pending",
              "ready",
              "rejected"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "id",
          "fileName",
          "contentType",
          "sizeBytes",
          "status",
          "createdAt"
        ],
        "title": "UploadResponse",
        "type": "object"
      },
      "UserResponse": {
        "properties": {
          "displayName": {
            "title": "Displayname",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "displayName"
        ],
        "title": "UserResponse",
        "type": "object"
      }
    }
  },
